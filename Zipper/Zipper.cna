#Zipper
#author Cornelis de Plaa
#@outflank.nl

#register help
beacon_command_register("zipper", "File and folder compression utility.",
	"Compress files and folders from local and UNC paths.\n\n" .
	"Synopsis: zipper -f [Full/UNC path]\n -p <password>" .
	"          zipper -f C:\\ImportantFolder\\LargeFile.ext -p <password>\n" .
	"          zipper -f C:\\ImportantFolder -p <password>\n" .
	"          zipper -f \\\\SERVER\\FileShare\\ImportantFolder -p <password>\n");

alias zipper {
    local('$bid' '$args');
	$bid = $1;
    $args = substr($0, 7);

    if ($args eq "") {
		berror($bid, "Please specify a valid path.");
		return;
	}

	blog($bid, "Let's start compressing, please wait...\n");
    bdllspawn($bid, script_resource("Zipper.dll"), $args, "Zipper", 5000, false);
}
